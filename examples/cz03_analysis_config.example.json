{
  "output_prefix": "cz03_insulation_analysis",
  "objective": "annual_power",
  "column_map": {
    "TDB": "DB Temperature",
    "TWB": "WB Temperature",
    "L": "load %"
  },
  "static_values": {
    "O": 100.0,
    "I": 150.0
  },
  "static_value_units": {
    "O": "ft",
    "I": "ft"
  },
  "candidates": {
    "To": [0.0, 0.25, 0.375, 0.5, 0.75, 1.0],
    "Ti": [0.0, 0.25, 0.375, 0.5, 0.75, 1.0]
  },
  "candidate_metadata": {
    "To": {
      "description": "Outdoor insulation thickness regression predictor. Keep as a candidate grid variable because CZ03 does not provide an hourly Outdoor Insulation Thickness field.",
      "units": "inches",
      "valid_range": [0.0, 1.0],
      "source": "docs/equations/power-capacity/*_regression_results.xlsx Predictions sheet, To column",
      "grid_variable": true,
      "hourly_measurement": false
    },
    "Ti": {
      "description": "Indoor insulation thickness regression predictor. Keep as a candidate grid variable because the CZ03 Indoor Insulation Thickness column is not populated with hourly values.",
      "units": "inches",
      "valid_range": [0.0, 1.0],
      "source": "docs/equations/power-capacity/*_regression_results.xlsx Predictions sheet, Ti column",
      "grid_variable": true,
      "hourly_measurement": false
    }
  },
  "load": {
    "column": "L",
    "scale": 1.0,
    "capacity_margin": 0.0
  },
  "equations": {
    "power": "0.8 + 0.02*TDB + 0.01*TWB + 0.15*L - 0.10*OIT*O - 0.08*IIT*I",
    "capacity": "100 - 0.30*TDB + 0.10*TWB + 2.0*OIT*O + 1.5*IIT*I"
  }
}
