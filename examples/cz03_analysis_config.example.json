{
  "output_prefix": "cz03_insulation_analysis",
  "objective": "annual_power",
  "column_map": {
    "TDB": "DB Temperature",
    "TWB": "WB Temperature",
    "L": "load %"
  },
  "static_values": {
    "O": 100.0,
    "I": 150.0
  },
  "static_value_units": {
    "O": "ft",
    "I": "ft"
  },
  "candidates": {
    "OIT": [0.5, 1.0, 1.5, 2.0],
    "IIT": [0.5, 1.0, 1.5, 2.0]
  },
  "load": {
    "column": "L",
    "scale": 1.0,
    "capacity_margin": 0.0
  },
  "equations": {
    "power": "0.8 + 0.02*TDB + 0.01*TWB + 0.15*L - 0.10*OIT*O - 0.08*IIT*I",
    "capacity": "100 - 0.30*TDB + 0.10*TWB + 2.0*OIT*O + 1.5*IIT*I"
  }
}
